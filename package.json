{
  "name": "youtubei-api",
  "version": "1.0.0",
  "description": "YouTube API with Next.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "INTEGRATION_TEST=true jest --testPathPattern=integration.test.js --runInBand",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "youtubei.js": "^16.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.0.3",
    "@types/react": "^19.1.8",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "node-mocks-http": "^1.17.2",
    "supertest": "^7.1.1",
    "typescript": "^5.8.3"
  }
}
